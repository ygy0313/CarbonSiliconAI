<view class="container">

  <view wx:if="{{declined}}" class="ack-bar" bindtap="reopenLegal">
    <text class="t-mini">还没同意隐私政策，记录暂不会保存 · 点这里看看</text>
  </view>

  <!-- 问候开场 -->
  <view class="greet">
    <view class="greet-date">{{greetDate}}</view>
    <view class="greet-hello">{{greetHello}}</view>
  </view>

  <!-- 身份条：点一下直接去「我的」页改档案；首页只显示昵称，不显示档案真名 -->
  <view class="id-row" bindtap="goMine">
    <view class="avatar">{{initial}}</view>
    <view class="grow">
      <view class="id-name {{hasNickname ? '' : 'id-name-empty'}}">{{name}}</view>
      <view class="id-sub" wx:if="{{hasNickname}}">{{identity}}</view>
      <view class="id-sub" wx:else>点这里去「我的」页完善档案</view>
    </view>
    <view class="id-right" wx:if="{{mode === 'old'}}">
      <text class="id-pct">{{completenessPct}}%</text>
      <text class="id-pct-label">档案</text>
    </view>
    <view class="mode-toggle-sm" wx:else catchtap="toggleMode">
      <text class="mode-toggle-text-sm">测·切老用户</text>
    </view>
  </view>

  <view class="t-mini mt-8" wx:if="{{offline}}">离线演示数据 · 后端未连接</view>

  <!-- 新人引导：三步把档案立起来 -->
  <block wx:if="{{mode === 'new'}}">
    <view class="mod-head">
      <view class="mod-icon">启</view>
      <text class="mod-title">先做三件事</text>
      <text class="mod-meta" bindtap="toggleMode">切到老用户 →</text>
    </view>
    <view class="card onboard">
      <view class="step {{ackDone ? 'done' : ''}}" bindtap="reopenLegal">
        <text class="step-no">{{ackDone ? '✓' : '1'}}</text>
        <view class="step-body">
          <view class="step-title">同意三件事</view>
          <view class="step-sub">隐私怎么保护、数据归谁，先说清楚再开始</view>
        </view>
        <text class="step-go">{{ackDone ? '' : '去同意 →'}}</text>
      </view>
      <view class="step {{quizDone ? 'done' : ''}}" bindtap="goQuiz">
        <text class="step-no">{{quizDone ? '✓' : quizDonePartially ? '…' : '2'}}</text>
        <view class="step-body">
          <view class="step-title">入局问答 {{quizDoneNum}} / {{quizTotal}}</view>
          <view class="step-sub">12 道选择题，选完档案就有骨架，不填表</view>
        </view>
        <text class="step-go">{{quizDone ? '' : quizDonePartially ? '继续答 →' : '开始答 →'}}</text>
      </view>
      <view class="step" bindtap="goRecord">
        <text class="step-no">3</text>
        <view class="step-body">
          <view class="step-title">记第一笔</view>
          <view class="step-sub">今天吃了什么、见了谁、在忙什么，一句话就行</view>
        </view>
        <text class="step-go">去记 →</text>
      </view>
      <view class="onboard-note">答完题、记几笔，首页就会长出「它对你的理解」。</view>
    </view>
  </block>

  <!-- ══ ① 运 · 今日运程：节气五行 + 今日日程（展示为主）══ -->
  <view class="mod-head">
    <view class="mod-icon">运</view>
    <text class="mod-title">今日运程</text>
    <text class="mod-meta">{{termText}}</text>
  </view>
  <view class="card">
    <block wx:if="{{gz}}">
      <view class="gz-pillars">
        <view wx:for="{{pillars}}" wx:key="label" class="gz-pillar">
          <text class="gz-pillar-label">{{item.label}}</text>
          <text class="gz-pillar-text">{{item.text}}</text>
          <text class="gz-pillar-el">{{item.el}}</text>
        </view>
      </view>
      <view class="gz-note">{{elementNote}}</view>
      <view class="gz-disclaim">干支五行是公共历法信息，只作节奏参考，不作吉凶、财运、健康断言。</view>
    </block>
    <view class="t-mini" wx:else>拿不到今日干支。检查服务地址后在「我的」页重试。</view>

    <view class="divider"></view>
    <view class="row between">
      <text class="t-sub">{{agenda.headline}}</text>
      <text class="t-mini">与手机日历单向打通：可写不可读（系统限制）</text>
    </view>
    <view wx:for="{{agenda.items}}" wx:key="id" class="ag-line">
      <text class="ag-time">{{item.time}}</text>
      <text class="ag-title-text grow">{{item.title}}</text>
      <text class="rec-btn" bindtap="addToCalendar" data-id="{{item.id}}">＋日历</text>
    </view>
    <view class="t-mini" wx:if="{{!agenda.count}}">空着也是信息 —— 这几天没人占用你。组局方案点「就这么定」后会自动排进来。</view>
  </view>

  <!-- ══ ② 味 · 今日食饮：吃 + 饮 揉在一卡，按时段出推荐 ══ -->
  <view class="mod-head">
    <view class="mod-icon">味</view>
    <text class="mod-title">今日食饮</text>
    <text class="mod-meta" wx:if="{{geoState === 'denied'}}" bindtap="openSetting">{{recCity}} · 开定位 ›</text>
    <text class="mod-meta" wx:else>{{slotText}} · {{recCity}}{{recNote ? ' · ' + recNote : ''}}</text>
  </view>

  <view class="card" wx:if="{{meal || brew}}">
    <!-- 吃 -->
    <block wx:if="{{meal}}">
      <view class="t-mini mod-tag">吃</view>
      <view class="rec-top">
        <text class="rec-title">{{meal.title}}</text>
        <text class="rec-kcal" wx:if="{{meal.kcal}}">{{meal.kcal}} kcal</text>
      </view>
      <view class="rec-desc">{{meal.desc}}</view>
      <view class="rec-why" wx:for="{{meal.why}}" wx:key="*this">· {{item}}</view>
      <view class="rec-actions">
        <text class="rec-btn rec-btn-main" data-kw="{{meal.keyword}}" data-app="大众点评" bindtap="copyKeyword">复制菜名去搜</text>
        <text class="rec-btn" data-kind="meal" bindtap="nextRec" wx:if="{{mealCount > 1}}">换一道</text>
      </view>
    </block>
    <view class="t-mini" wx:else>这一餐的推荐还没算出来。</view>

    <!-- 饮：茶 / 咖啡 / 汤饮 和吃长在同一张卡里 -->
    <block wx:if="{{brew}}">
      <view class="divider"></view>
      <view class="t-mini mod-tag">饮</view>
      <view class="rec-top">
        <text class="rec-title">{{brew.title}}</text>
      </view>
      <view class="rec-desc">{{brew.desc}}</view>
      <view class="rec-why" wx:for="{{brew.why}}" wx:key="*this">· {{item}}</view>
      <view class="rec-actions" wx:if="{{brewCount > 1}}">
        <text class="rec-btn" data-kind="brew" bindtap="nextRec">换一杯</text>
      </view>
    </block>

    <!-- 酒：只在晚 / 宵时段出现 -->
    <block wx:if="{{wine}}">
      <view class="divider"></view>
      <view class="t-mini mod-tag">酒</view>
      <view class="rec-top">
        <text class="rec-title">{{wine.title}}</text>
      </view>
      <view class="rec-desc">{{wine.desc}}</view>
      <view class="rec-why" wx:for="{{wine.why}}" wx:key="*this">· {{item}}</view>
      <view class="rec-why" wx:if="{{wine.serve}}">· {{wine.serve}}</view>
      <view class="rec-actions">
        <text class="rec-btn rec-btn-main" data-kw="{{wine.short}}" data-app="淘宝" bindtap="copyKeyword">复制酒名去搜</text>
      </view>
    </block>
  </view>
  <view class="card" wx:else>
    <view class="t-mini">推荐还没算出来。检查服务地址，或直接跟执笔说一句「{{slotText}}吃什么」。</view>
    <view class="rec-actions">
      <text class="rec-btn rec-btn-main" bindtap="openSetting" wx:if="{{geoState === 'denied'}}">允许定位，按附近推荐</text>
      <text class="rec-btn" bindtap="goChat" data-text="{{slotText}}吃什么">去问执笔</text>
    </view>
  </view>

  <!-- ══ ③ 动 · 动一动：只报今天消耗与缺口，动作偏好在档案里选 ══ -->
  <view class="mod-head">
    <view class="mod-icon">动</view>
    <text class="mod-title">动一动</text>
    <text class="mod-meta" bindtap="goMine">{{moveLike || '去档案选个动作 ›'}}</text>
  </view>
  <view class="card">
    <block wx:if="{{werun}}">
      <view class="move-big">
        <text class="move-num">{{werun.kcal}}</text>
        <text class="move-unit">kcal 今天已消耗</text>
      </view>
      <view class="t-mini">约 {{werun.step}} 步（取整到百位）。{{werunNote}}</view>
      <view class="t-mini mt-8" wx:if="{{moveGapText}}">{{moveGapText}}</view>
      <view class="t-mini mt-8" wx:else>在「我的 · 档案」设个每日消耗目标，这里帮你盯着缺口。</view>
    </block>
    <block wx:else>
      <view class="t-mini">微信运动还没授权或暂无数据。授权后这里自动显示今天的量，并自动记入档案——不用再点按钮。</view>
      <view class="rec-actions">
        <text class="rec-btn rec-btn-main" bindtap="goMine">去「授权」打开微信运动</text>
      </view>
    </block>

    <view class="divider"></view>
    <view class="t-mini" wx:if="{{moveLike}}">你选的动作是「{{moveLike}}」。要换，去「我的 · 档案 · 动起来想做什么」。</view>
    <view class="t-mini" wx:else>还没选运动偏好。以前这里硬推「快走 30 分钟」，现在改成你自己定 —— 去「我的 · 档案」挑一个。</view>
  </view>

  <!-- ══ ④ 梦 · 灵光一现：梦 / idea / 金句 / 单词 / link ══ -->
  <view class="mod-head">
    <view class="mod-icon">梦</view>
    <text class="mod-title">灵光一现</text>
    <text class="mod-meta">写下来就自动记入档案</text>
  </view>
  <view class="card">
    <textarea class="input dream-input" value="{{dreamText}}" bindinput="onDreamText"
              placeholder="记录你的灵光一现：梦、idea、金句、单词、文章&视频 link" maxlength="500" auto-height />
    <view class="rec-actions">
      <text class="rec-btn rec-btn-main" bindtap="exploreCreate">{{dreamBusy ? '记着…' : '探索&创造'}}</text>
      <text class="rec-btn" bindtap="breakThrough">破个局</text>
    </view>
    <view class="t-mini">「探索&创造」：记进档案，并顺着这条线给一本书、一部片、一句话；「破个局」：拆一拆 —— 梦拆意象与情绪，想法拆出下一步。只给方向，不作吉凶预示。</view>

    <block wx:if="{{dream}}">
      <view class="divider"></view>
      <view class="row wrap gap-8" wx:if="{{dream.motifs.length}}">
        <text wx:for="{{dream.motifs}}" wx:key="*this" class="tag tag-green">{{item}}</text>
      </view>
      <view class="t-body mt-16">{{dream.line}}</view>
      <view class="t-mini mt-8" wx:if="{{dream.tone && dream.tone !== '未说明'}}">情绪基调：{{dream.tone}}</view>
      <view class="t-mini mt-8" wx:if="{{dream.prior}}">这个意象你以前梦到过 {{dream.prior}} 次 —— 我只记频率，不解释含义。</view>
      <view class="t-mini mt-8" wx:if="{{!dream.motifs.length}}">意象没认出来，原文已经存好。换个说法再说一遍，能拆得更细。</view>
    </block>

    <block wx:if="{{sparkPicks.length}}">
      <view class="divider"></view>
      <view class="t-sub">顺着这条线，你可以看看</view>
      <view wx:for="{{sparkPicks}}" wx:key="topicId" class="spark-row">
        <view class="t-mini">{{item.topic}}</view>
        <view class="t-body mt-8">{{item.book.title}}<text class="t-mini"> · {{item.book.author}}</text></view>
        <view class="t-mini mt-8">{{item.book.note}}</view>
        <view class="t-mini mt-8" wx:if="{{item.watch}}">可看：{{item.watch.title}}</view>
        <view class="t-mini mt-8" wx:if="{{item.line}}">「{{item.line.text}}」——{{item.line.from}}</view>
      </view>
      <view class="t-mini mt-8">公开来源，不卖课、没有返佣。不喜欢就跳过。</view>
    </block>
  </view>

  <view class="services-entry" bindtap="goServices" wx:if="{{mode === 'old'}}">
    <text class="t-sub">已接入 {{serviceCount}} 个生活服务 · 查看服务市场</text>
  </view>

  <!-- ══ 记 · 按日翻记录：默认今天，可挑任意一天 ══ -->
  <view class="mod-head">
    <view class="mod-icon">记</view>
    <text class="mod-title">你的记录</text>
    <picker mode="date" end="{{recDate}}" value="{{recDate}}" bindchange="onRecDate">
      <text class="mod-meta t-green">{{recDateLabel}} ›</text>
    </picker>
  </view>
  <view class="card">
    <view class="t-mini" wx:if="{{dayLoading}}">翻着…</view>
    <block wx:else>
      <view class="t-sub">{{recDateLabel}}记了 {{dayCount}} 笔</view>
      <view wx:for="{{dayRecords}}" wx:key="id" class="ag-line">
        <text class="ag-time">{{item.time}}</text>
        <text class="ag-title-text grow">{{item.summary}}</text>
      </view>
      <view class="t-mini mt-8" wx:if="{{!dayCount}}">这天还没落笔。想补记，去「记录」页写一句。</view>
      <view class="rec-actions">
        <text class="rec-btn rec-btn-main" bindtap="goRecord">去补一笔</text>
      </view>
    </block>
  </view>

</view>

<!-- 首次使用前的同意层：不挡住看，只挡住写 -->
<view wx:if="{{needAck}}" class="ack-mask">
  <view class="ack-panel">
    <view class="ack-title">先说清三件事</view>
    <view class="ack-body">
      <text class="ack-p">你说的每句话，先抹掉手机号、证件号、门牌这类信息，再加密单独存放。主库里只有抹过的版本。</text>
      <text class="ack-p">要读原文、要导出、要还原身份字段，都得你亲手签一张有时限的票，用完记一笔账，你自己能查。</text>
      <text class="ack-p">数据归你：随时能改、能导出带走、能删。不卖第三方，不拿去训练对外模型，当前版本没有广告。</text>
    </view>
    <view class="ack-links">
      <text class="ack-link" data-doc="privacy" bindtap="openDoc">《隐私政策》</text>
      <text class="ack-link" data-doc="terms" bindtap="openDoc">《用户协议》</text>
    </view>
    <view class="btn btn-primary mt-16" bindtap="ackLegal">同意，开始记</view>
    <view class="ack-decline" bindtap="declineLegal">先不同意，只看看</view>
  </view>
</view>
