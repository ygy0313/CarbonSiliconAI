<view class="container">

  <view wx:if="{{declined}}" class="ack-bar" bindtap="reopenLegal">
    <text class="t-mini">还没同意隐私政策，记录暂不会保存 · 点这里看看</text>
  </view>

  <!-- 问候开场 -->
  <view class="greet">
    <view class="greet-date">{{greetDate}}</view>
    <view class="greet-hello">{{greetHello}}</view>
  </view>

  <!-- 身份条：首页只显示昵称，不显示档案真名 -->
  <view class="id-row">
    <view class="avatar">{{initial}}</view>
    <view class="grow" bindtap="setNickname">
      <view class="id-name {{hasNickname ? '' : 'id-name-empty'}}">{{name}}</view>
      <view class="id-sub" wx:if="{{hasNickname}}">{{identity}}</view>
      <view class="id-sub" wx:else>昵称只存在这台手机上 · 点这里设置</view>
    </view>
    <view class="id-right" wx:if="{{mode === 'old'}}" bindtap="goProfile">
      <text class="id-pct">{{completenessPct}}%</text>
      <text class="id-pct-label">档案</text>
    </view>
    <view class="mode-toggle-sm" wx:else bindtap="toggleMode">
      <text class="mode-toggle-text-sm">测·切老用户</text>
    </view>
  </view>

  <view class="t-mini mt-8" wx:if="{{offline}}">离线演示数据 · 后端未连接</view>

  <!-- ── 第一个模块：今日五行（公共历法信息，只谈节奏，不作预测）── -->
  <view class="section">
    <text class="section-title">今日五行</text>
    <text class="section-more" wx:if="{{termText}}">{{termText}}</text>
  </view>
  <view class="card gz-card" wx:if="{{gz}}">
    <view class="gz-pillars">
      <view wx:for="{{pillars}}" wx:key="label" class="gz-pillar">
        <text class="gz-pillar-label">{{item.label}}</text>
        <text class="gz-pillar-text">{{item.text}}</text>
        <text class="gz-pillar-el">{{item.el}}</text>
      </view>
    </view>

    <view class="gz-bars">
      <view wx:for="{{elementBars}}" wx:key="el" class="gz-bar-row">
        <text class="gz-bar-el">{{item.el}}</text>
        <view class="gz-bar-track">
          <view class="gz-bar-fill gz-el-{{item.cls}}" style="width:{{item.w}}%"></view>
        </view>
        <text class="gz-bar-pct">{{item.pct}}%</text>
      </view>
    </view>

    <view class="gz-note">{{elementNote}}</view>
    <view class="gz-disclaim">干支与五行是公共历法信息，只作为节奏参考，不作吉凶、财运、健康方面的断言。</view>
  </view>
  <view class="card" wx:else>
    <view class="t-mini">拿不到今日干支。检查服务地址后在「档案」页重试。</view>
  </view>

  <!-- ── 新人引导：三步把档案立起来 ── -->
  <block wx:if="{{mode === 'new'}}">
    <view class="section">
      <text class="section-title">先做三件事</text>
      <text class="section-more" bindtap="toggleMode">切到老用户 →</text>
    </view>
    <view class="card onboard">
      <view class="step {{ackDone ? 'done' : ''}}" bindtap="reopenLegal">
        <text class="step-no">{{ackDone ? '✓' : '1'}}</text>
        <view class="step-body">
          <view class="step-title">同意三件事</view>
          <view class="step-sub">隐私怎么保护、数据归谁，先说清楚再开始</view>
        </view>
        <text class="step-go">{{ackDone ? '' : '去同意 →'}}</text>
      </view>
      <view class="step {{quizDone ? 'done' : ''}}" bindtap="goQuiz">
        <text class="step-no">{{quizDone ? '✓' : quizDonePartially ? '…' : '2'}}</text>
        <view class="step-body">
          <view class="step-title">入局问答 {{quizDoneNum}} / {{quizTotal}}</view>
          <view class="step-sub">12 道选择题，选完档案就有骨架，不填表</view>
        </view>
        <text class="step-go">{{quizDone ? '' : quizDonePartially ? '继续答 →' : '开始答 →'}}</text>
      </view>
      <view class="step" bindtap="goRecord">
        <text class="step-no">3</text>
        <view class="step-body">
          <view class="step-title">记第一笔</view>
          <view class="step-sub">今天吃了什么、见了谁、在忙什么，一句话就行</view>
        </view>
        <text class="step-go">去记 →</text>
      </view>
      <view class="onboard-note">答完题、记几笔，首页就会长出「它对你的理解」。</view>
    </view>
  </block>

  <!-- ── 现在要做什么：不再是天窗，直接给算好的结果 ── -->
  <view class="section">
    <text class="section-title">现在要做什么</text>
    <text class="section-more" bindtap="goChatEmpty">直接说 →</text>
  </view>
  <view class="rec-head">
    <text class="rec-city">{{recCity || '按档案城市'}}</text>
    <text class="rec-note">{{recNote}}</text>
    <text class="rec-geo" wx:if="{{geoState === 'denied'}}" bindtap="goProfile">开定位 ›</text>
  </view>

  <view class="rec-card" wx:if="{{recFood}}">
    <view class="rec-top">
      <text class="rec-tag rec-tag-eat">吃</text>
      <text class="rec-title">{{recFood.title}}</text>
      <text class="rec-kcal" wx:if="{{recFood.kcal}}">{{recFood.kcal}} kcal</text>
    </view>
    <view class="rec-desc">{{recFood.desc}}</view>
    <view class="rec-why" wx:for="{{recFood.why}}" wx:key="*this">· {{item}}</view>
    <view class="rec-actions">
      <text class="rec-btn rec-btn-main" data-kw="{{recFood.keyword}}" data-app="大众点评" bindtap="copyKeyword">去大众点评搜</text>
      <text class="rec-btn" bindtap="goChat" data-text="中午吃什么，把菜点出来">换个说法</text>
    </view>
  </view>

  <view class="rec-card" wx:if="{{recMove}}">
    <view class="rec-top">
      <text class="rec-tag rec-tag-move">动</text>
      <text class="rec-title">{{recMove.title}}</text>
      <text class="rec-kcal" wx:if="{{recMove.kcal}}">{{recMove.kcal}} kcal</text>
    </view>
    <view class="rec-desc">{{recMove.desc}}</view>
    <view class="rec-why" wx:for="{{recMove.why}}" wx:key="*this">· {{item}}</view>
    <view class="rec-actions">
      <text class="rec-btn rec-btn-main" data-kw="{{recMove.keyword}}" data-app="Keep" bindtap="copyKeyword">去 Keep 搜跟练</text>
      <text class="rec-btn" bindtap="openMyMap">看我的位置</text>
    </view>
  </view>

  <view class="rec-empty" wx:if="{{!recFood && !recMove}}">推荐还没算出来。检查服务地址，或直接在下面说一句你的需要。</view>

  <view class="quick-grid mt-16">
    <view wx:for="{{quick}}" wx:key="key" class="quick" bindtap="goChat" data-text="{{item.text}}">
      <text class="quick-label">{{item.label}}</text>
      <text class="quick-arrow">→</text>
    </view>
  </view>

  <view class="services-entry" bindtap="goServices" wx:if="{{mode === 'old'}}">
    <text class="t-sub">已接入 {{serviceCount}} 个生活服务 · 查看服务市场</text>
  </view>

  <view class="btn btn-ghost mt-24" bindtap="goRecord">记一笔</view>

</view>

<!-- 首次使用前的同意层：不挡住看，只挡住写 -->
<view wx:if="{{needAck}}" class="ack-mask">
  <view class="ack-panel">
    <view class="ack-title">先说清三件事</view>
    <view class="ack-body">
      <text class="ack-p">你说的每句话，先抹掉手机号、证件号、门牌这类信息，再加密单独存放。主库里只有抹过的版本。</text>
      <text class="ack-p">要读原文、要导出、要还原身份字段，都得你亲手签一张有时限的票，用完记一笔账，你自己能查。</text>
      <text class="ack-p">数据归你：随时能改、能导出带走、能删。不卖第三方，不拿去训练对外模型，当前版本没有广告。</text>
    </view>
    <view class="ack-links">
      <text class="ack-link" data-doc="privacy" bindtap="openDoc">《隐私政策》</text>
      <text class="ack-link" data-doc="terms" bindtap="openDoc">《用户协议》</text>
    </view>
    <view class="btn btn-primary mt-16" bindtap="ackLegal">同意，开始记</view>
    <view class="ack-decline" bindtap="declineLegal">先不同意，只看看</view>
  </view>
</view>
