<view class="container">

  <view wx:if="{{declined}}" class="ack-bar" bindtap="reopenLegal">
    <text class="t-mini">还没同意隐私政策，记录暂不会保存 · 点这里看看</text>
  </view>

  <!-- 主视觉：一块深绿，把「你是谁 + 档案长到哪了」一次说清 -->
  <view class="hero mt-8">
    <view class="row gap-16">
      <view class="avatar avatar-on-dark">{{initial}}</view>
      <view class="grow">
        <view class="hero-title">{{name}}</view>
        <view class="hero-sub">{{identity}}</view>
      </view>
      <text class="hero-pct">{{completenessPct}}%</text>
    </view>

    <view class="hero-bar mt-24">
      <view class="hero-bar-fill" style="width:{{completenessPct}}%"></view>
    </view>
    <view class="dim-grid mt-16">
      <view wx:for="{{dims}}" wx:key="key" class="dim {{item.cls}}"></view>
    </view>
    <view class="hero-mini mt-16">{{filled}} / {{total}} 个维度有据可依 · 缺的会主动问你</view>
  </view>

  <view class="t-mini mt-8" wx:if="{{offline}}">离线演示数据 · 后端未连接</view>

  <view class="section">
    <text class="section-title">它现在这样理解你</text>
    <text class="section-more" bindtap="goProfile">去核对</text>
  </view>
  <view class="card">
    <view wx:for="{{hints}}" wx:key="*this" class="hint-row">
      <view class="dot"></view>
      <text class="t-body grow">{{item}}</text>
    </view>
    <view class="t-mini mt-8" wx:if="{{!hints.length}}">记录几条之后，这里会长出它对你的判断。</view>
  </view>

  <view class="section">
    <text class="section-title">现在要做什么</text>
    <text class="section-more" bindtap="goChatEmpty">直接说 →</text>
  </view>
  <view class="quick-grid">
    <view wx:for="{{quick}}" wx:key="key" class="quick" bindtap="goChat" data-text="{{item.text}}">
      <text class="quick-label">{{item.label}}</text>
      <text class="quick-arrow">→</text>
    </view>
  </view>
  <view class="services-entry" bindtap="goServices">
    <text class="t-sub">已接入 {{serviceCount}} 个生活服务 · 查看服务市场</text>
  </view>

  <view class="section">
    <text class="section-title">最近的记忆</text>
    <text class="section-more" bindtap="goProfile">全部</text>
  </view>
  <view class="card" wx:if="{{recent.length}}">
    <view wx:for="{{recent}}" wx:key="id" class="memory">
      <view class="row between">
        <text class="t-body grow">{{item.summary}}</text>
        <text class="t-mini">{{item.when}}</text>
      </view>
      <view class="row wrap mt-8" wx:if="{{item.tags.length}}">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>还没有记录。执笔对你还一无所知。</view>

  <view class="btn btn-ghost mt-24" bindtap="goRecord">记一笔</view>

</view>

<!-- 首次使用前的同意层：不挡住看，只挡住写 -->
<view wx:if="{{needAck}}" class="ack-mask">
  <view class="ack-panel">
    <view class="ack-title">先说清三件事</view>
    <view class="ack-body">
      <text class="ack-p">你说的每句话，先抹掉手机号、证件号、门牌这类信息，再加密单独存放。主库里只有抹过的版本。</text>
      <text class="ack-p">要读原文、要导出、要还原身份字段，都得你亲手签一张有时限的票，用完记一笔账，你自己能查。</text>
      <text class="ack-p">数据归你：随时能改、能导出带走、能删。不卖第三方，不拿去训练对外模型，当前版本没有广告。</text>
    </view>
    <view class="ack-links">
      <text class="ack-link" data-doc="privacy" bindtap="openDoc">《隐私政策》</text>
      <text class="ack-link" data-doc="terms" bindtap="openDoc">《用户协议》</text>
    </view>
    <view class="btn btn-primary mt-16" bindtap="ackLegal">同意，开始记</view>
    <view class="ack-decline" bindtap="declineLegal">先不同意，只看看</view>
  </view>
</view>
