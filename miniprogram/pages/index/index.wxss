/* ── 问候开场 ───────────────────────────────────────── */
.greet {
  padding: 8rpx 4rpx 0;
}
.greet-date {
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}
.greet-hello {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
}

/* ── 新人/老用户视角切换 ────────────────────────────── */
.mode-toggle {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
}
.mode-toggle-text {
  font-size: 22rpx;
  color: #d7e8dd;
}
.mode-switch-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
.mode-switch {
  font-size: 22rpx;
  color: var(--text-3);
  padding: 6rpx 12rpx;
}

/* ── 新人引导卡：三步，做完打勾 ─────────────────────── */
.onboard {
  padding: 12rpx 24rpx;
}
.step {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.step:last-of-type { border-bottom: none; }
.step-no {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--green-dim, rgba(0, 112, 74, 0.1));
  color: var(--green);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step.done .step-no {
  background: var(--green);
  color: #fff;
}
.step-body { flex: 1; }
.step-title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--text);
}
.step.done .step-title { color: var(--text-2); }
.step-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.5;
}
.step-go {
  font-size: 24rpx;
  color: var(--green);
  flex-shrink: 0;
}
.onboard-note {
  padding: 8rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* ── 主视觉块（深绿底，所有子元素用浅色系）───────── */
.avatar-on-dark {
  background: rgba(255, 255, 255, 0.14);
  color: #e9f2ec;
}
.hero-pct {
  font-size: 44rpx;
  font-weight: 600;
  color: #9fe3bd;
  flex-shrink: 0;
}
.hero-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
}
.hero-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #7fd6a8;
  transition: width 0.3s ease;
}
.hero-mini {
  font-size: 22rpx;
  color: #a8c0b4;
  line-height: 1.6;
}

.dim-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.dim {
  width: 56rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.16);
}
.dim.on { background: #7fd6a8; }
.dim.weak { background: rgba(255, 255, 255, 0.5); }
.dim.off { background: rgba(255, 255, 255, 0.16); }

.hint-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
}
.hint-row .dot { margin-top: 14rpx; }

.quick-grid {
  display: flex;
  flex-direction: row;
  /* 快捷入口会随着能力增加而变多，必须能换行 —— 一行硬塞 5 个会被压成竖排字 */
  flex-wrap: wrap;
  gap: 16rpx;
}
.quick {
  flex: 1 1 30%;
  min-width: 200rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 136rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.quick:active { background: var(--surface-2); }
.quick-label {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
}
.quick-arrow {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 14rpx;
}

.services-entry {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx dashed var(--line);
  border-radius: 16rpx;
}

.memory {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.memory:last-child { border-bottom: none; padding-bottom: 0; }
.memory:first-child { padding-top: 0; }

/* ── 同意层：只挡住写，不挡住看 ─────────────────── */
.ack-bar {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  padding: 18rpx 20rpx;
  border: 1rpx dashed var(--amber);
  border-radius: 14rpx;
  background: var(--amber-dim);
}

.ack-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(20, 24, 22, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.ack-panel {
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 36rpx 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
}

.ack-title {
  font-size: 34rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 20rpx;
}

.ack-body {
  display: flex;
  flex-direction: column;
}

.ack-p {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--text-2);
  margin-bottom: 14rpx;
}

.ack-links {
  display: flex;
  flex-direction: row;
  margin: 6rpx 0 8rpx;
}

.ack-link {
  font-size: 26rpx;
  color: var(--green);
  margin-right: 24rpx;
}

.ack-decline {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
  padding: 12rpx 0;
}
