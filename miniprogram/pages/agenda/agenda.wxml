<view class="container">

  <view class="ag-head">
    <view class="ag-title">日程</view>
    <view class="t-mini mt-8">这里只放你自己认下的事。执笔的推荐要你点头才落地。</view>
  </view>

  <!-- ── 加一件事：默认今天，时刻可以不定 ── -->
  <view class="card ag-form">
    <input class="input ag-input" value="{{title}}" bindinput="onTitle" placeholder="要做什么，一句话就够" maxlength="60" />
    <view class="row wrap gap-8 mt-16">
      <view wx:for="{{dateChips}}" wx:key="date" class="{{item.on ? 'chip chip-on' : 'chip'}}" data-date="{{item.date}}" bindtap="pickDate">{{item.label}}</view>
      <picker mode="date" value="{{date}}" start="{{todayKey}}" bindchange="pickOtherDate">
        <view class="chip">{{date === todayKey ? '其他日子' : date}}</view>
      </picker>
    </view>
    <view class="row wrap gap-8">
      <picker mode="time" value="{{time || '09:00'}}" bindchange="pickTime">
        <view class="chip {{time ? 'chip-on' : ''}}">{{time ? time : '定个时刻'}}</view>
      </picker>
      <view class="chip" wx:if="{{time}}" bindtap="clearTime">不定时刻</view>
    </view>
    <button class="btn btn-primary mt-16" bindtap="save" disabled="{{saving}}">{{saving ? '记下中…' : '记下这件事'}}</button>
  </view>

  <view class="t-mini mt-16" wx:if="{{headline}}">{{headline}}{{offline ? ' · 服务没连上' : ''}}</view>

  <!-- ── 按天分组 ── -->
  <block wx:for="{{groups}}" wx:key="date">
    <view class="section">
      <text class="section-title">{{item.label}}</text>
      <text class="section-more">{{item.dateLabel}}</text>
    </view>
    <view class="card">
      <view wx:for="{{item.items}}" wx:for-item="it" wx:key="id" class="{{it.rowCls}}">
        <view class="{{it.checkCls}}" catchtap="toggle" data-id="{{it.id}}" data-done="{{it.done}}">
          <text class="ag-check-mark">{{it.done ? '✓' : ''}}</text>
        </view>
        <view class="grow">
          <view class="ag-name">{{it.title}}</view>
          <view class="t-mini mt-8">{{it.time ? it.time : '待定'}}{{it.place ? ' · ' + it.place : ''}}{{it.overdue ? ' · 已过期' : ''}}</view>
        </view>
        <text class="ag-del" catchtap="remove" data-id="{{it.id}}">删</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && !groups.length}}">接下来 7 天空着。空着也是信息 —— 这几天没人占用你。</view>

  <view class="btn btn-ghost mt-24" bindtap="goRecord">去记一笔发生了什么</view>

</view>
