.record-input {
  height: 220rpx;
  line-height: 1.6;
}

.result { padding-top: 8rpx; }

.change {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.change:last-child { border-bottom: none; }
.change-label { font-size: 25rpx; color: var(--text-2); width: 160rpx; flex-shrink: 0; }
.change-val { flex: 1; display: flex; flex-direction: row; gap: 8rpx; align-items: center; }
.change-before { font-size: 24rpx; color: var(--text-3); text-decoration: line-through; }

.conflict {
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(150, 105, 15, 0.3);
  border-radius: 14rpx;
  background: var(--amber-dim);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hint-box {
  padding: 20rpx 24rpx;
  border: 1rpx dashed var(--line);
  border-radius: 14rpx;
}
.hint-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
  padding: 8rpx 0;
}
.hint-row .dot { margin-top: 14rpx; }

/* ── 拍张照 / 按住说话 ─────────────────────── */
.tool-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.tool {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 22rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}
.tool:active { opacity: 0.7; }
.tool-dim { opacity: 0.45; }
.tool-rec {
  border-color: var(--amber);
  background: var(--amber-dim);
}
.tool-ico {
  font-size: 30rpx;
  margin-right: 10rpx;
}
.tool-txt {
  font-size: 26rpx;
  color: var(--text-2);
}
.tool-rec .tool-txt { color: var(--amber); }

.dish-box {
  padding: 20rpx 22rpx;
  border: 1rpx dashed var(--line);
  border-radius: 14rpx;
}
.dish {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--surface-2);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  margin: 0 10rpx 10rpx 0;
}
