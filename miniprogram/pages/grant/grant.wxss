.grant-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.grant-row.is-dead {
  opacity: 0.45;
}

.token-box {
  padding: 20rpx;
  background: #1e3932;
  border: 1rpx solid rgba(143, 217, 176, 0.22);
  border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
  color: #8fd9b0;
}

.prompt-box {
  max-height: 560rpx;
  overflow: auto;
  padding: 20rpx;
  background: #1e3932;
  border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  color: #c3d1ca;
  white-space: pre-wrap;
  word-break: break-word;
}
