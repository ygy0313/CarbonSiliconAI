.grant-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.grant-row.is-dead {
  opacity: 0.45;
}

.token-box {
  padding: 20rpx;
  background: #060a0e;
  border: 1rpx solid rgba(74, 222, 128, 0.25);
  border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
  color: #4ade80;
}

.prompt-box {
  max-height: 560rpx;
  overflow: auto;
  padding: 20rpx;
  background: #060a0e;
  border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  color: #c8d2dc;
  white-space: pre-wrap;
  word-break: break-word;
}
