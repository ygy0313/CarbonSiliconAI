/* 我的：一段一屏。全局 .section 只放标题行，内容一律进 .card。 */

/* ── 三段切换：档案 / 身体 / 数据 ── */
.seg-bar {
  display: flex;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  background: var(--surface-2);
  border-radius: 999rpx;
}
.seg {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 999rpx;
  text-align: center;
}
.seg-on {
  background: var(--surface);
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 32, 0.06);
}
.seg-text {
  font-size: 26rpx;
  color: var(--text-3);
}
.seg-on .seg-text {
  color: var(--green);
  font-weight: 600;
}

/* ── 冲突裁决：琥珀，置顶 ── */
.conflict-box {
  border: 1rpx solid rgba(150, 105, 15, 0.3);
  background: var(--amber-dim);
  border-radius: 16rpx;
  padding: 24rpx;
}
.conflict-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(31, 35, 32, 0.04);
  border-radius: 12rpx;
}

/* ── 事实行：点即改，置信度条诚实标出「多可靠」── */
.fact {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.fact:last-child { border-bottom: none; padding-bottom: 0; }
.fact:first-child { padding-top: 0; }
.fact-label { font-size: 26rpx; color: var(--text-2); flex-shrink: 0; }
.fact-value {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  max-width: 340rpx;
  text-align: right;
}
.is-empty { color: var(--text-3); font-weight: 400; }

.conf-bar {
  flex: 1;
  height: 6rpx;
  background: var(--line-soft);
  border-radius: 999rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.conf-fill {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
}
.conf-weak { background: var(--amber); }


/* ── 头卡 ── */
.me-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0 8rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--green-deep);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}
.me-more {
  font-size: 26rpx;
  color: var(--green);
  flex-shrink: 0;
}

/* ── 八字表单：每行两个等宽格，块式布局 ── */
.bz-form {
  display: flex;
  gap: 16rpx;
}
.bz-item {
  flex: 1;
  min-width: 0;
}
.pick-box {
  padding: 20rpx 24rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 27rpx;
  color: var(--text);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}
.pick-box.is-empty {
  color: var(--text-3);
}
.bz-place {
  flex: 1;
}
.bz-btn {
  margin-top: 24rpx;
}
.bz-divider {
  height: 1rpx;
  background: var(--line);
  margin: 32rpx 0;
}

/* 四柱格 */
.bz-pillars {
  display: flex;
  gap: 14rpx;
}
.bz-pillar {
  flex: 1;
  padding: 22rpx 0;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.bz-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.bz-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.bz-el {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ── 健康：微信运动 ── */
.weun-btn {
  margin-top: 4rpx;
}
.weun-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.weun-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--green);
  line-height: 1.1;
}
.weun-unit {
  font-size: 26rpx;
  color: var(--text-3);
}
.weun-week {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}
.weun-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.weun-bar-bg {
  width: 100%;
  height: 96rpx;
  border-radius: 8rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.weun-bar {
  width: 100%;
  background: var(--green);
  border-radius: 8rpx 8rpx 0 0;
}
.weun-date {
  font-size: 19rpx;
  color: var(--text-3);
}

/* ── 理解你 ── */
.hint-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--green);
  margin-top: 16rpx;
  flex-shrink: 0;
}

/* ── 记忆行（与首页同款）── */
.memory {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.memory:last-child {
  border-bottom: none;
}

/* ── 授权 / 审计行 ── */
.grant-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.grant-row:last-child {
  border-bottom: none;
}
.grant-row.is-dead {
  opacity: 0.45;
}

/* ── 代码块（prompt / token）── */
.prompt-box {
  max-height: 560rpx;
  overflow: auto;
  padding: 20rpx;
  background: #1e3932;
  border-radius: 14rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  color: #c3d1ca;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── 五行分布条（英文类名，WXSS 不认中文）── */
.gz-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.gz-bar-name {
  width: 40rpx;
  font-size: 24rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.gz-bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line);
  overflow: hidden;
}
.gz-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
  transition: width 0.3s ease;
}
.gz-bar-fill.gz-el-mu { background: #4E8C6A; }
.gz-bar-fill.gz-el-huo { background: #B4553F; }
.gz-bar-fill.gz-el-tu { background: #A9873F; }
.gz-bar-fill.gz-el-jin { background: #8A8F92; }
.gz-bar-fill.gz-el-shui { background: #3E6F8C; }
.gz-bar-pct {
  width: 68rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

/* 八字紧凑版：日期 + 时辰一行两个 */
.bz-compact {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.bz-compact .bz-item { flex: 1; }

/* 「它现在这样理解你」：每条判断带匹配度条 */
.hint-score {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.hint-score:last-child { border-bottom: none; }
.hint-bar {
  height: 10rpx;
  background: var(--surface-2);
  border-radius: 6rpx;
  overflow: hidden;
}
.hint-fill {
  height: 100%;
  background: var(--green);
  border-radius: 6rpx;
}

/* 琥珀标签：脱敏命中提示 */
.tag-amber {
  color: var(--amber);
  border: 1rpx solid var(--amber);
}

/* 经验统计：三个数字格 */
.asset-grid {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.asset-cell {
  flex: 1;
  background: var(--surface-2, #F5F3EE);
  border-radius: 14rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.asset-num { font-size: 34rpx; font-weight: 600; color: var(--green); }
.asset-label { font-size: 22rpx; color: var(--text-3); }

/* Obsidian 笔记列表 */
.obs-item {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.obs-item:last-child { border-bottom: none; }
