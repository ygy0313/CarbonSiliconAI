/* 我的：个人属性聚合页。全局 .section 只放标题行，内容一律进 .card。 */

/* ── 头卡 ── */
.me-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0 8rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--green-deep);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}
.me-more {
  font-size: 26rpx;
  color: var(--green);
  flex-shrink: 0;
}

/* ── 八字表单：每行两个等宽格，块式布局 ── */
.bz-form {
  display: flex;
  gap: 16rpx;
}
.bz-item {
  flex: 1;
  min-width: 0;
}
.pick-box {
  padding: 20rpx 24rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 27rpx;
  color: var(--text);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}
.pick-box.is-empty {
  color: var(--text-3);
}
.bz-place {
  flex: 1;
}
.bz-btn {
  margin-top: 24rpx;
}
.bz-divider {
  height: 1rpx;
  background: var(--line);
  margin: 32rpx 0;
}

/* 四柱格 */
.bz-pillars {
  display: flex;
  gap: 14rpx;
}
.bz-pillar {
  flex: 1;
  padding: 22rpx 0;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.bz-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.bz-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}
.bz-el {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ── 健康：微信运动 ── */
.weun-btn {
  margin-top: 4rpx;
}
.weun-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.weun-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--green);
  line-height: 1.1;
}
.weun-unit {
  font-size: 26rpx;
  color: var(--text-3);
}
.weun-week {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}
.weun-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.weun-bar-bg {
  width: 100%;
  height: 96rpx;
  border-radius: 8rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.weun-bar {
  width: 100%;
  background: var(--green);
  border-radius: 8rpx 8rpx 0 0;
}
.weun-date {
  font-size: 19rpx;
  color: var(--text-3);
}

/* ── 理解你 ── */
.hint-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--green);
  margin-top: 16rpx;
  flex-shrink: 0;
}

/* ── 记忆行（与首页同款）── */
.memory {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.memory:last-child {
  border-bottom: none;
}

/* ── 授权 / 审计行 ── */
.grant-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.grant-row:last-child {
  border-bottom: none;
}
.grant-row.is-dead {
  opacity: 0.45;
}

/* ── 代码块（prompt / token）── */
.prompt-box {
  max-height: 560rpx;
  overflow: auto;
  padding: 20rpx;
  background: #1e3932;
  border-radius: 14rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  color: #c3d1ca;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ── 五行分布条（英文类名，WXSS 不认中文）── */
.gz-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}
.gz-bar-name {
  width: 40rpx;
  font-size: 24rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.gz-bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line);
  overflow: hidden;
}
.gz-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
  transition: width 0.3s ease;
}
.gz-bar-fill.gz-el-mu { background: #4E8C6A; }
.gz-bar-fill.gz-el-huo { background: #B4553F; }
.gz-bar-fill.gz-el-tu { background: #A9873F; }
.gz-bar-fill.gz-el-jin { background: #8A8F92; }
.gz-bar-fill.gz-el-shui { background: #3E6F8C; }
.gz-bar-pct {
  width: 68rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}
