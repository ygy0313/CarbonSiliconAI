<view class="container">

  <!-- ── 头卡：昵称 / 完整度 ── -->
  <view class="me-head" bindtap="setNickname">
    <view class="me-avatar">{{hasNickname ? nickname[0] : '起'}}</view>
    <view class="grow">
      <view class="me-name">{{hasNickname ? nickname : '给自己起个昵称'}}</view>
      <view class="t-mini mt-8">档案完整度 {{completenessPct || '0'}}% · 点名字可改昵称</view>
    </view>
    <text class="me-more">{{filledCount}} / {{dimTotal}} 项</text>
  </view>

  <view class="t-mini mt-8" wx:if="{{offline}}">离线演示 · 改动不会保存</view>

  <!-- ── 三段切换：我是谁 / 我的健康 / 数据归谁 ── -->
  <view class="seg-bar">
    <view wx:for="{{segs}}" wx:key="key" class="seg {{seg === item.key ? 'seg-on' : ''}}" data-seg="{{item.key}}" bindtap="switchSeg">
      <text class="seg-text">{{item.label}}</text>
    </view>
  </view>

  <!-- ══ 档案：我是谁（生辰置顶 → 经验 → 完整度 → 事实维度）══ -->
  <block wx:if="{{seg === 'file'}}">

    <!-- 生辰：紧凑版，改完自动生成命盘 -->
    <view class="section mt-16">
      <text class="section-title">生辰</text>
      <text class="section-more">{{chart ? '已生成 · 改动自动更新' : '选好日期自动生成'}}</text>
    </view>
    <view class="card">
      <view class="bz-compact">
        <picker class="bz-item" mode="date" start="1900-01-01" end="2026-12-31" value="{{birthDate}}" bindchange="onBirthDate">
          <view class="pick-box {{birthDate ? '' : 'is-empty'}}">{{birthDate || '出生年月日'}}</view>
        </picker>
        <picker class="bz-item" range="{{hourOptions}}" value="{{hourIdx}}" bindchange="onHourPick">
          <view class="pick-box">{{hourOptions[hourIdx]}}</view>
        </picker>
      </view>
      <view class="mt-16">
        <input class="input" value="{{birthPlace}}" bindinput="onPlace" bindblur="onPlaceDone" placeholder="出生城市（可不填）" maxlength="12" />
      </view>

      <block wx:if="{{chart}}">
        <view class="bz-divider"></view>
        <view class="bz-pillars">
          <view wx:for="{{chart.four}}" wx:key="label" class="bz-pillar">
            <text class="bz-label">{{item.label}}</text>
            <text class="bz-text">{{item.text}}</text>
            <text class="bz-el" wx:if="{{item.hourLabel}}">{{item.hourLabel}}</text>
          </view>
        </view>
        <view class="t-sub mt-16">日主 {{chart.dayMaster.gan}}（{{chart.dayMaster.element}}）· 五行偏 {{chart.dayMaster.taste}}</view>
        <view class="gz-bar-row" wx:for="{{chartBars}}" wx:key="el">
          <text class="gz-bar-name">{{item.el}}</text>
          <view class="gz-bar-track">
            <view class="gz-bar-fill gz-el-{{item.cls}}" style="width:{{item.w}}%"></view>
          </view>
          <text class="gz-bar-pct">{{item.pct}}%</text>
        </view>
        <view class="t-mini mt-8">{{chart.note}}</view>
      </block>
      <view class="t-mini mt-16" wx:else>只描述构成与偏好倾向，不作吉凶断言。选好出生日期，命盘自动排出来。</view>
    </view>

    <!-- 经验：后台沉淀的决策规则，只看总量与方向，明细去 Obsidian 看 -->
    <view class="section">
      <text class="section-title">经验</text>
      <text class="section-more">后台数据 · 明细在 Obsidian</text>
    </view>
    <view class="card" wx:if="{{assetsStats}}">
      <view class="row between">
        <text class="t-body">共 {{assetsStats.total}} 条经验</text>
        <text class="t-mini">{{assetsStats.solidified}} 条已固化</text>
      </view>
      <view class="asset-grid mt-16">
        <view class="asset-cell"><text class="asset-num">{{assetsStats.active}}</text><text class="asset-label">可用</text></view>
        <view class="asset-cell"><text class="asset-num">{{assetsStats.hitPct}}</text><text class="asset-label">奏效率</text></view>
        <view class="asset-cell"><text class="asset-num">{{assetsStats.effPct}}</text><text class="asset-label">平均有效</text></view>
      </view>
      <view class="t-mini mt-8" wx:if="{{assetsStats.nextText}}">{{assetsStats.nextText}}</view>
    </view>
    <view class="card" wx:else>
      <view class="t-mini">还没有经验数据。同类事情记够两次，会自动提炼成一条经验。</view>
    </view>

    <view class="card mt-16">
      <view class="row between">
        <text class="t-sub">它对你的把握</text>
        <text class="t-green t-body">{{completenessPct || '0'}}%</text>
      </view>
      <view class="bar mt-16">
        <view class="bar-fill" style="width:{{completenessPct}}%"></view>
      </view>
      <view class="t-mini mt-8">{{filledCount}} / {{dimTotal}} 个维度有记录 · 百分比按置信度加权，越低越值得你确认一遍</view>
    </view>

    <view wx:if="{{conflicts.length}}" class="conflict-box mt-16">
      <view class="t-amber t-sub">有 {{conflicts.length}} 件事跟你原来的说法对不上</view>
      <view wx:for="{{conflicts}}" wx:key="id" class="conflict-item" bindtap="resolve" data-id="{{item.id}}">
        <text class="t-body">{{item.question}}</text>
        <text class="t-mini mt-8">点这里定一下 →</text>
      </view>
    </view>

    <view wx:for="{{groups}}" wx:key="name">
      <view class="section">
        <text class="section-title">{{item.name}}</text>
        <text class="section-more">{{item.items.length}} 项</text>
      </view>
      <view class="card">
        <view wx:for="{{item.items}}" wx:for-item="f" wx:key="key" class="fact" bindtap="editFact" data-key="{{f.key}}">
          <view class="row between">
            <text class="fact-label">{{f.label}}</text>
            <text class="fact-value {{f.empty ? 'is-empty' : ''}}">{{f.value}}</text>
          </view>
          <view class="row between mt-8">
            <view class="conf-bar">
              <view class="conf-fill {{f.weak ? 'conf-weak' : ''}}" style="width:{{f.pct}}%"></view>
            </view>
            <text class="t-mini">{{f.pct}}%</text>
          </view>
          <text class="t-mini mt-8" wx:if="{{f.note}}">{{f.note}}</text>
        </view>
      </view>
    </view>

  </block>

  <!-- ══ 健康：只看授权情况与脱敏摘要；明细在首页「动」模块 ══ -->
  <block wx:elif="{{seg === 'body'}}">

    <view class="section">
      <text class="section-title">数据来源与授权</text>
      <text class="section-more">本页只显示脱敏摘要</text>
    </view>
    <view class="card">
      <view class="row between">
        <text class="t-body">微信运动（步数）</text>
        <text class="tag {{weun ? 'tag-green' : ''}}">{{weun ? '已授权' : '未读取'}}</text>
      </view>
      <view class="t-mini mt-8">要读取需要你点头授权；读取的是微信记的步数。拿到后自动记入档案，不用再点按钮。</view>

      <view class="divider"></view>
      <view class="row between">
        <text class="t-body">iPhone「健康」库</text>
        <text class="tag">不接入</text>
      </view>
      <view class="t-mini mt-8">系统限制：小程序拿不到 iPhone 健康库数据，这个来源不展示、不做手工补录。</view>
    </view>

    <view class="section">
      <text class="section-title">今日运动量（脱敏）</text>
    </view>
    <view class="card">
      <block wx:if="{{weun}}">
        <view class="row between">
          <text class="t-body">今天走了约 {{weun.step}} 步</text>
          <text class="rec-kcal">≈ {{weun.kcal}} kcal</text>
        </view>
        <view class="t-mini mt-8">步数取整到百位，逐日明细不出本页。今天的量已自动记入档案。</view>
      </block>
      <block wx:else>
        <view class="t-mini">还没读取。点下面按钮并授权微信运动后，这里显示今天的量级。</view>
        <button class="btn btn-primary weun-btn mt-16" bindtap="readWeRun" disabled="{{weunBusy}}">{{weunBusy ? '读取中…' : '读取今日步数（需授权）'}}</button>
      </block>
    </view>

  </block>

  <!-- ══ 数据：它怎么看我 + 数据归谁 ══ -->
  <block wx:else>

    <view class="section">
      <text class="section-title">它现在这样理解你</text>
      <text class="section-more">带匹配度</text>
    </view>
    <view class="card">
      <view wx:for="{{hints}}" wx:key="text" class="hint-score">
        <view class="row between">
          <text class="t-body grow">{{item.text}}</text>
          <text class="t-mini">{{item.label}}</text>
        </view>
        <view class="hint-bar mt-8">
          <view class="hint-fill" style="width:{{item.pct}}%"></view>
        </view>
        <text class="t-mini mt-8">{{item.pct}}%</text>
      </view>
      <view class="t-mini" wx:if="{{!hints.length}}">记录几条之后，这里会长出它对你的判断。</view>
      <view class="t-mini mt-8" wx:if="{{hintNote}}">{{hintNote}}</view>
    </view>

    <view class="section">
      <text class="section-title">个人简历</text>
      <text class="section-more">原文进保险箱</text>
    </view>
    <view class="card">
      <view class="t-mini">把简历交给执笔，它抹掉手机号、证件号、门牌这类信息后入库；敏感片段加密单独存放，读原文需要你亲手签授权。</view>
      <view class="row wrap gap-8 mt-16">
        <button class="btn btn-ghost btn-sm" bindtap="pickResumeFile">从聊天选文件（txt / md）</button>
        <button class="btn btn-primary btn-sm" bindtap="submitResume" disabled="{{resumeBusy}}">{{resumeBusy ? '脱敏入库中…' : '存这份简历'}}</button>
      </view>
      <view class="mt-16">
        <textarea class="input" value="{{resumeText}}" bindinput="onResumeText"
                  placeholder="也可以直接把简历内容粘贴到这里" maxlength="20000" auto-height />
      </view>
      <view class="row wrap gap-8 mt-16" wx:if="{{resumeHits.length}}">
        <text wx:for="{{resumeHits}}" wx:key="*this" class="tag tag-amber">{{item}} 已抹掉</text>
      </view>
      <view class="t-mini mt-8" wx:if="{{resumeInfo}}">{{resumeInfo}}</view>
    </view>

    <view class="section">
      <text class="section-title">最近的记忆</text>
      <text class="section-more">最近 5 条</text>
    </view>
    <view class="card" wx:if="{{recent.length}}">
      <view wx:for="{{recent}}" wx:key="id" class="memory">
        <view class="row between">
          <text class="t-body grow">{{item.summary}}</text>
          <text class="t-mini">{{item.when}}</text>
        </view>
        <view class="row wrap mt-8" wx:if="{{item.tags.length}}">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="t-mini">还没有记录。执笔对你还一无所知。</view>
    </view>

    <view class="section">
      <text class="section-title">Obsidian 笔记</text>
      <text class="section-more">经验与决策沉淀的地方</text>
    </view>
    <view class="card">
      <view class="t-mini">你在 Obsidian 里写的决策笔记，会经 git 同步到这边参与执笔的判断。这里可以翻看，也可以整库导出带走。</view>
      <view class="row wrap gap-8 mt-16">
        <button class="btn btn-primary btn-sm" bindtap="openObsidian" disabled="{{busy}}">{{obsidianLoaded ? '刷新列表' : '查看我的笔记'}}</button>
        <button class="btn btn-ghost btn-sm" bindtap="exportObsidian" disabled="{{busy}}" wx:if="{{obsidianLoaded}}">导出整库到剪贴板</button>
      </view>
      <view class="t-mini mt-8" wx:if="{{obsidianLoaded}}">共 {{obsidianCount}} 篇{{obsidianTruncated ? '（导出只含最近一部分）' : ''}} · 点标题展开正文</view>
      <view class="t-mini mt-8" wx:if="{{obsidianInfo}}">{{obsidianInfo}}</view>
      <view class="obs-list mt-8" wx:if="{{obsidianNotes.length}}">
        <view wx:for="{{obsidianNotes}}" wx:key="path" class="obs-item">
          <view class="row between" bindtap="toggleNote" data-path="{{item.path}}">
            <text class="t-body grow">{{item.title}}</text>
            <text class="t-mini">{{item.sizeText}}{{item.when ? ' · ' + item.when : ''}}</text>
          </view>
          <view wx:if="{{expandedNote === item.path}}" class="prompt-box mt-8">{{noteContent}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">我的 Prompt</text>
    </view>
    <view class="card">
      <view class="t-mini">执笔怎么理解你、怎么跟你说话，都由这段提示词驱动 —— 你的档案、经验、Obsidian 笔记都汇在这里。查看时会自动签一张 15 分钟、3 次的授权，留档可查。</view>
      <view class="row wrap gap-8 mt-16">
        <button class="btn btn-primary btn-sm" bindtap="viewMyPrompt" disabled="{{busy}}">查看我的 Prompt</button>
        <button class="btn btn-ghost btn-sm" bindtap="exportMine" disabled="{{busy}}">导出档案</button>
        <button class="btn btn-ghost btn-sm" wx:if="{{promptText}}" bindtap="copyPrompt">复制</button>
      </view>
      <view class="t-mini mt-8" wx:if="{{exportInfo}}">{{exportInfo}}</view>
      <view class="prompt-box mt-16" wx:if="{{promptText}}">{{promptText}}</view>
    </view>

    <view class="section">
      <text class="section-title">授权记录</text>
      <text class="section-more">谁能读你的原文</text>
    </view>
    <view class="card" wx:if="{{grants.length}}">
      <view wx:for="{{grants}}" wx:key="id" class="{{item.rowCls}}">
        <view class="grow">
          <view class="t-body">{{item.scopeText}}</view>
          <view class="t-mini mt-8">{{item.purpose}} · {{item.stateText}}</view>
        </view>
        <button class="btn btn-ghost btn-sm" wx:if="{{!item.revoked}}" bindtap="revoke" data-id="{{item.id}}">撤销</button>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="t-mini">还没有授权发生。每次有人（包括执笔自己）要读你的原文，都会先在这里签一张有用途、有期限、有次数的授权。</view>
    </view>

    <view class="section">
      <text class="section-title">数据账本</text>
      <text class="section-more">只追加，不改写</text>
    </view>
    <view class="card" wx:if="{{audits.length}}">
      <view wx:for="{{audits}}" wx:key="id" class="grant-row">
        <text class="t-mini">{{item.time}}</text>
        <text class="t-mini grow">{{item.text}}</text>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="t-mini">暂无动账记录。</view>
    </view>

    <view class="section">
      <text class="section-title">法律文本</text>
    </view>
    <view class="card">
      <view class="row wrap gap-8">
        <button class="btn btn-ghost btn-sm" bindtap="goLegal" data-doc="privacy">隐私政策</button>
        <button class="btn btn-ghost btn-sm" bindtap="goLegal" data-doc="terms">用户协议</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title">开发设置</text>
      <text class="section-more" bindtap="toggleSettings">{{showSettings ? '收起' : '展开'}}</text>
    </view>
    <view class="card" wx:if="{{showSettings}}">
      <view class="row between" bindtap="saveBase">
        <text class="t-sub">服务地址</text>
        <text class="t-mini mono">{{apiBase}}</text>
      </view>
      <view class="t-mini mt-16">真机调试请填电脑的局域网 IP，如 http://192.168.1.10:8787</view>
    </view>

  </block>

</view>
