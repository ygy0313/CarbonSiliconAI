/* 经验资产页：数字要醒目，规则要能一眼读完。 */

.xp-grid {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.xp-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  background: var(--surface-2);
  border-radius: 12rpx;
}
.xp-num {
  font-size: 34rpx;
  color: var(--text);
  font-weight: 600;
}
.xp-lab {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.xp-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.xp-item:last-child { border-bottom: none; padding-bottom: 0; }
.xp-item:first-child { padding-top: 0; }

.xp-rule {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
}

.xp-bar {
  height: 6rpx;
  background: var(--surface-2);
  border-radius: 4rpx;
  overflow: hidden;
}
.xp-fill {
  display: block;
  height: 6rpx;
  border-radius: 4rpx;
}
.xp-fill.hi { background: var(--green); }
.xp-fill.mid { background: var(--amber); }
.xp-fill.lo { background: var(--text-3); }

.xp-acts {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.xp-act {
  margin-left: 12rpx;
}

.crit-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.crit-input {
  width: 110rpx;
  height: 60rpx;
  margin: 0 12rpx;
  padding: 0 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text);
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
}
