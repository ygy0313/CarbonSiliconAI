<view class="container">

  <view class="t-title">经验</view>
  <view class="t-sub mt-8">记下来的事会变成规则。规则用得对不对，由结果改分。</view>

  <view wx:if="{{loading}}" class="empty">正在算…</view>

  <block wx:else>

    <view wx:if="{{offline}}" class="card mt-16">
      <text class="t-body">{{hint}}</text>
      <view class="btn btn-ghost btn-sm mt-16" bindtap="load">重试</view>
    </view>

    <!-- 概览 -->
    <view wx:if="{{assets}}" class="card card-primary mt-24">
      <view class="row between">
        <text class="t-mini">共 {{assets.total}} 条经验</text>
        <text class="t-mini t-green">{{assets.solidified}} 条已固化</text>
      </view>
      <view class="xp-grid mt-16">
        <view class="xp-cell">
          <text class="xp-num">{{assets.active}}</text>
          <text class="xp-lab">可用</text>
        </view>
        <view class="xp-cell">
          <text class="xp-num">{{assets.appliedTotal}}</text>
          <text class="xp-lab">被调用</text>
        </view>
        <view class="xp-cell">
          <text class="xp-num">{{hitPct}}</text>
          <text class="xp-lab">奏效率</text>
        </view>
        <view class="xp-cell">
          <text class="xp-num">{{effPct}}</text>
          <text class="xp-lab">平均有效</text>
        </view>
      </view>
      <view class="t-mini mt-16">近 7 天新增 {{assets.growth.last7}} 条，近 30 天 {{assets.growth.last30}} 条</view>
    </view>

    <!-- 下一步 -->
    <view wx:if="{{assets}}" class="card mt-16">
      <view class="t-mini">下一步</view>
      <view class="t-body mt-8">{{nextText}}</view>
      <view class="btn btn-primary btn-sm mt-16" bindtap="reflect">
        <text wx:if="{{reflecting}}">正在提炼…</text>
        <text wx:else>立即提炼</text>
      </view>
      <view wx:if="{{hint}}" class="t-mini mt-8">{{hint}}</view>
    </view>

    <!-- 分组列表 -->
    <block wx:for="{{groups}}" wx:key="key">
      <view class="section">
        <text class="section-title">{{item.label}}</text>
        <text class="section-more">{{item.count}} 条</text>
      </view>
      <view class="t-mini mb-8">{{item.hint}}</view>
      <view class="card">
        <view wx:for="{{item.items}}" wx:for-item="xp" wx:key="id" class="xp-item">
          <view class="xp-rule">{{xp.rule}}</view>
          <view class="row wrap mt-8">
            <text class="tag">{{xp.flow}}</text>
            <text wx:if="{{xp.solidified}}" class="tag tag-green">已固化</text>
            <text class="tag">{{xp.sourceLabel}}</text>
          </view>
          <view class="xp-bar mt-8">
            <view class="xp-fill {{xp.barCls}}" style="width:{{xp.pct}}%"></view>
          </view>
          <view class="row between mt-8">
            <text class="t-mini">有效性 {{xp.pct}}%</text>
            <view class="xp-acts">
              <view wx:for="{{xp.acts}}" wx:for-item="a" wx:key="label"
                    class="{{a.cls}} xp-act" bindtap="onAct"
                    data-id="{{xp.id}}" data-act="{{a.act}}" data-value="{{a.value}}">{{a.label}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!groups.length && assets}}" class="card mt-16">
      <text class="t-body">还没有经验。先记几条做过的事，同一类事攒够两次，执笔会自己提炼出规则。</text>
      <view class="btn btn-ghost btn-sm mt-16" bindtap="goRecord">去记一笔</view>
    </view>

    <!-- 双环：标准由人定 -->
    <view class="section">
      <text class="section-title">什么算「有效」</text>
      <text class="section-more">v{{critVersion}}</text>
    </view>
    <view class="card">
      <view class="t-mini">它自己能调每条经验的分数（单环）；但多少分算有效，必须由你定（双环）。{{critConfirmed}}。</view>

      <view class="crit-row mt-16">
        <text class="t-sub">高于</text>
        <input class="crit-input" type="number" value="{{critPromote}}"
               data-key="critPromote" bindinput="onCritInput" />
        <text class="t-sub">分固化为技能</text>
      </view>
      <view class="crit-row mt-8">
        <text class="t-sub">低于</text>
        <input class="crit-input" type="number" value="{{critArchive}}"
               data-key="critArchive" bindinput="onCritInput" />
        <text class="t-sub">分进入休眠</text>
      </view>
      <view class="crit-row mt-8">
        <text class="t-sub">至少用够</text>
        <input class="crit-input" type="number" value="{{critSamples}}"
               data-key="critSamples" bindinput="onCritInput" />
        <text class="t-sub">次才升降级</text>
      </view>

      <view class="btn btn-ghost btn-sm mt-16" bindtap="saveCriteria">确认修改</view>
    </view>

  </block>

</view>
