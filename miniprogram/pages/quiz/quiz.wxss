/* ── 进度头 ─────────────────────────────── */
.q-head {
  margin-top: 16rpx;
}
.q-progress-text {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}
.q-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--line);
  overflow: hidden;
}
.q-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
  transition: width 0.3s ease;
}
.q-group {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--green);
}

/* ── 题卡 ───────────────────────────────── */
.q-card {
  margin-top: 16rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.q-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}
.q-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.q-options {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.q-opt {
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper, #FBFAF8);
}
.q-opt:active {
  border-color: var(--green);
  background: rgba(0, 112, 74, 0.06);
}
.q-opt.busy { opacity: 0.5; }
.q-opt-label {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}
.q-hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* ── 完成卡 ─────────────────────────────── */
.q-done-card {
  margin-top: 48rpx;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.q-done-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text);
}
.q-done-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

/* ── 杂项 ───────────────────────────────── */
.q-loading {
  margin-top: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.quiz-error {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--amber, #96690F);
  line-height: 1.6;
}
.quiz-retry {
  color: var(--green);
}
