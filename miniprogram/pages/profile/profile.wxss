.pct-box {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--green-dim);
}

.conflict-box {
  border: 1rpx solid rgba(150, 105, 15, 0.3);
  background: var(--amber-dim);
  border-radius: 16rpx;
  padding: 24rpx;
}
.conflict-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(31, 35, 32, 0.04);
  border-radius: 12rpx;
}

.fact {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.fact:last-child { border-bottom: none; padding-bottom: 0; }
.fact:first-child { padding-top: 0; }
.fact-main { width: 100%; }
.fact-label { font-size: 26rpx; color: var(--text-2); }
.fact-value { font-size: 28rpx; color: var(--text); font-weight: 500; max-width: 340rpx; text-align: right; }
.is-empty { color: var(--text-3); font-weight: 400; }

.conf-bar {
  flex: 1;
  height: 6rpx;
  background: var(--line-soft);
  border-radius: 999rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.conf-fill {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
}
.conf-weak { background: var(--amber); }

.mem {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mem:last-child { border-bottom: none; padding-bottom: 0; }
.mem:first-child { padding-top: 0; }
.mem .dot { margin-top: 14rpx; }
