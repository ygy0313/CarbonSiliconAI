/* 硅基记忆体 · 设计系统
   深色底 = 硅基的冷；绿色与琥珀 = 记忆的温度。
   所有页面只引用这里的基础类，页面级 wxss 只写差异。 */

page {
  --bg: #0b0f14;
  --surface: #141b23;
  --surface-2: #1a232d;
  --line: rgba(255, 255, 255, 0.07);
  --text: #e8edf2;
  --text-2: #8a9aab;
  --text-3: #5c6b7a;
  --green: #4ade80;
  --green-dim: rgba(74, 222, 128, 0.12);
  --amber: #f5b942;
  --amber-dim: rgba(245, 185, 66, 0.12);
  --red: #f26d6d;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx 32rpx 80rpx;
}

/* ── 文字 ── */
.t-hero {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}
.t-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}
.t-body {
  font-size: 28rpx;
  color: var(--text);
}
.t-sub {
  font-size: 26rpx;
  color: var(--text-2);
}
.t-mini {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 0.5rpx;
}
.t-green { color: var(--green); }
.t-amber { color: var(--amber); }
.t-red { color: var(--red); }
.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  letter-spacing: 0;
}

/* ── 布局 ── */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }

/* ── 卡片 ── */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-soft {
  background: var(--surface-2);
  border: none;
}
.card-primary {
  border-color: rgba(74, 222, 128, 0.35);
  background: linear-gradient(160deg, rgba(74, 222, 128, 0.09), rgba(20, 27, 35, 0.9) 55%);
}
.card-plan {
  border-color: rgba(245, 185, 66, 0.35);
  background: linear-gradient(160deg, rgba(245, 185, 66, 0.1), rgba(20, 27, 35, 0.92) 60%);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ── 标签 ── */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text-2);
  margin: 0 12rpx 12rpx 0;
}
.chip-on {
  background: var(--green-dim);
  border-color: rgba(74, 222, 128, 0.5);
  color: var(--green);
}
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: var(--surface-2);
  color: var(--text-3);
  margin-right: 10rpx;
}
.tag-green { background: var(--green-dim); color: var(--green); }
.tag-amber { background: var(--amber-dim); color: var(--amber); }

/* ── 按钮 ── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: var(--surface-2);
  color: var(--text);
  border: 1rpx solid var(--line);
}
.btn-primary {
  background: var(--green);
  color: #07120c;
  border: none;
  font-weight: 600;
}
.btn-ghost {
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--line);
}
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  display: inline-flex;
  width: auto;
}
.btn:active { opacity: 0.75; }

/* ── 进度条 ── */
.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2fb96a, #4ade80);
}
.bar-amber {
  background: linear-gradient(90deg, #d99a28, #f5b942);
}

/* ── 头像 ── */
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1f7a4d, #4ade80);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #04150c;
  flex-shrink: 0;
}

/* ── 状态点 ── */
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--green);
  flex-shrink: 0;
}
.dot-idle { background: var(--text-3); }
.dot-warn { background: var(--amber); }

/* ── 区块标题 ── */
.section {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 18rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.section-more {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ── 输入 ── */
.input {
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  color: var(--text);
  font-size: 28rpx;
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
}
.placeholder { color: var(--text-3); }

/* ── 空态 ── */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-3);
  font-size: 26rpx;
}
