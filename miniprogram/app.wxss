/* 起居注 · 设计系统
   取向：纸白底 + 白卡片 + 深绿点睛。留白优先，靠字重和间距分层，不靠边框和色块堆叠。
   参照：星巴克 App 的清爽感 ／ 「给您请安」的绿白纸面。
   所有页面只引用这里的基础类，页面级 wxss 只写差异。 */

page {
  --bg: #fbfaf8;
  --surface: #ffffff;
  --surface-2: #f3f0ea;
  --line: #e7e2d9;
  --line-soft: #f0ece4;
  --text: #1f2320;
  --text-2: #5b655f;
  --text-3: #7a847e;
  --green: #00704a;
  --green-deep: #1e3932;
  --green-light: #00a862;
  --green-dim: rgba(0, 112, 74, 0.08);
  --amber: #96690f;
  --amber-dim: rgba(150, 105, 15, 0.09);
  --red: #c0392b;
  --shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 32rpx 36rpx 96rpx;
}

/* ── 文字 ── */
.t-hero {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.25;
}
.t-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}
.t-body {
  font-size: 28rpx;
  color: var(--text);
}
.t-sub {
  font-size: 26rpx;
  color: var(--text-2);
}
.t-mini {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 0.5rpx;
}
.t-green { color: var(--green); }
.t-amber { color: var(--amber); }
.t-red { color: var(--red); }
.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  letter-spacing: 0;
}

/* ── 布局 ── */
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }

/* ── 深绿块：星巴克那种「一片叶子落在纸上」 ── */
.hero {
  background: var(--green-deep);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
}
.hero-title {
  color: #f2f7f4;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.35;
}
.hero-sub {
  color: #a8c0b4;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ── 卡片 ── */
.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(31, 35, 32, 0.04), 0 10rpx 30rpx rgba(31, 35, 32, 0.05);
}
.card-soft {
  background: var(--surface-2);
  box-shadow: none;
}
.card-primary {
  box-shadow: 0 1rpx 2rpx rgba(0, 112, 74, 0.08), 0 10rpx 30rpx rgba(0, 112, 74, 0.08);
  border-left: 6rpx solid var(--green);
}
.card-plan {
  box-shadow: 0 1rpx 2rpx rgba(150, 105, 15, 0.08), 0 10rpx 28rpx rgba(150, 105, 15, 0.06);
  border-left: 6rpx solid var(--amber);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ── 标签 ── */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text-2);
  margin: 0 12rpx 12rpx 0;
}
.chip-on {
  background: var(--green);
  border-color: var(--green);
  color: #ffffff;
  font-weight: 500;
}
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: var(--surface-2);
  color: var(--text-3);
  margin-right: 10rpx;
}
.tag-green { background: var(--green-dim); color: var(--green); }
.tag-amber { background: var(--amber-dim); color: var(--amber); }

/* ── 按钮 ── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--line);
}
.btn-primary {
  background: var(--green);
  color: #ffffff;
  border: none;
  font-weight: 600;
}
.btn-ghost {
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--line);
}
.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  display: inline-flex;
  width: auto;
}
.btn:active { opacity: 0.75; }

/* ── 进度条 ── */
.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--line-soft);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #00603f, #00a862);
}
.bar-amber {
  background: linear-gradient(90deg, #7d5407, #c9922a);
}

/* ── 头像 ── */
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--green-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #e9f2ec;
  flex-shrink: 0;
}

/* ── 状态点 ── */
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--green);
  flex-shrink: 0;
}
.dot-idle { background: var(--text-3); }
.dot-warn { background: var(--amber); }

/* ── 区块标题：左侧绿竖条，星巴克货架式的分区 ── */
.section {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  border-left: 7rpx solid var(--green);
  padding-left: 18rpx;
  line-height: 1.25;
}
.section-more {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ── 输入 ── */
.input {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx;
  color: var(--text);
  font-size: 28rpx;
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
}
.placeholder { color: var(--text-3); }

/* ── 空态 ── */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-3);
  font-size: 26rpx;
}
